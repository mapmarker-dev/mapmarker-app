<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 서버 API와 로그인. debug 매니페스트에만 있던 권한을 출시 빌드에도 둔다. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <application
        android:label="MapMarker"
        android:allowBackup="false"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- 카카오 로그인: 카카오 계정 로그인 뒤 돌아오는 주소(kakao<네이티브 앱 키>://oauth).
             키는 Gradle이 앱 .env의 KAKAO_NATIVE_APP_KEY에서 넣는다(app/build.gradle.kts). -->
        <activity
            android:name="com.kakao.sdk.flutter.auth.AuthCodeHandlerActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="${kakaoScheme}" android:host="oauth"/>
            </intent-filter>
        </activity>
        <!-- 네이버 로그인. 값은 Gradle이 android/local.properties에서 넣는다(app/build.gradle.kts).
             SDK가 초기화에 Client Secret을 요구해서 APK에 들어가는 것은 피할 수 없다. -->
        <meta-data
            android:name="com.naver.sdk.clientId"
            android:value="${naverClientId}" />
        <meta-data
            android:name="com.naver.sdk.clientSecret"
            android:value="@string/naver_client_secret" />
        <meta-data
            android:name="com.naver.sdk.clientName"
            android:value="${naverClientName}" />
        <!-- debug 빌드에서도 플러그인 로그를 끈다. 켜면 설정값과 토큰 정보가 logcat에 남는다. -->
        <meta-data
            android:name="com.naver.sdk.logEnabled"
            android:value="false" />
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
